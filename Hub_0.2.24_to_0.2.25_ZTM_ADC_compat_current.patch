+{
+    ztmb_zap_lock_t *adapter = (ztmb_zap_lock_t *)context;
+    if (!adapter) {
+        return -1;
+    }
+    if (timeout_us == 0u) {
+        uint32_t owner = 0u;
+        return mutex_try_enter(&adapter->mutex, &owner) ? 0 : -1;
+    }
+    return mutex_enter_timeout_us(&adapter->mutex, timeout_us) ? 0 : -1;
+}
+
+static void adapter_lock_release(void *context)
+{
+    ztmb_zap_lock_t *adapter = (ztmb_zap_lock_t *)context;
+    if (adapter) {

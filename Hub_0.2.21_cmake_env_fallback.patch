diff --git a/CMakeLists.txt b/CMakeLists.txt
index b386e0e..0637225 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -87,6 +87,17 @@ configure_file(
 # Network credentials are local build settings, not source-code defaults.
 set(HUB_WIFI_SSID "" CACHE STRING "Wi-Fi SSID used by the Hub reference application")
 set(HUB_WIFI_PASSWORD "" CACHE STRING "Wi-Fi password used by the Hub reference application")
+
+# Allow IDE/direct-CMake builds to use the same local environment variables
+# as build.ps1. Explicit -D cache values still take precedence.
+if(NOT HUB_WIFI_SSID AND DEFINED ENV{ZAP_HUB_WIFI_SSID})
+    set(HUB_WIFI_SSID "$ENV{ZAP_HUB_WIFI_SSID}"
+        CACHE STRING "Wi-Fi SSID used by the Hub reference application" FORCE)
+endif()
+if(NOT HUB_WIFI_PASSWORD AND DEFINED ENV{ZAP_HUB_WIFI_PASSWORD})
+    set(HUB_WIFI_PASSWORD "$ENV{ZAP_HUB_WIFI_PASSWORD}"
+        CACHE STRING "Wi-Fi password used by the Hub reference application" FORCE)
+endif()
 set(HUB_WIFI_SSID_C "${HUB_WIFI_SSID}")
 set(HUB_WIFI_PASSWORD_C "${HUB_WIFI_PASSWORD}")
 foreach(_wifi_var HUB_WIFI_SSID_C HUB_WIFI_PASSWORD_C)
@@ -109,10 +120,20 @@ pico_sdk_init()
 # any Hub source.
 set(ZAPEE_SOURCE "" CACHE PATH
     "Path to a local ZapEE checkout")
+
+# Allow IDE/direct-CMake builds to use the same local checkout configured for
+# build.ps1. Explicit -DZAPEE_SOURCE still takes precedence.
+if(NOT ZAPEE_SOURCE AND DEFINED ENV{ZAPEE_SOURCE})
+    file(TO_CMAKE_PATH "$ENV{ZAPEE_SOURCE}" _zapee_env_source)
+    set(ZAPEE_SOURCE "${_zapee_env_source}"
+        CACHE PATH "Path to a local ZapEE checkout" FORCE)
+endif()
+
 if(NOT ZAPEE_SOURCE)
     message(FATAL_ERROR
         "ZAPEE_SOURCE is required. "
-        "Pass -DZAPEE_SOURCE=<path> or use build.ps1 -ZapEEPath <path>.")
+        "Set the ZAPEE_SOURCE environment variable, pass -DZAPEE_SOURCE=<path>, "
+        "or use build.ps1 -ZapEEPath <path>.")
 endif()
 if(NOT EXISTS "${ZAPEE_SOURCE}/CMakeLists.txt")
     message(FATAL_ERROR

+# Generated by zap.ps1 from ../zap.yml. DO NOT EDIT BY HAND.
+# Experienced CMake users may replace this file with normal FetchContent/add_subdirectory logic.
+include(FetchContent)
+
+set(ZAP_DEPS_DIR "deps" CACHE PATH "Zap dependency source directory")
+if(NOT IS_ABSOLUTE "${ZAP_DEPS_DIR}")
+    set(ZAP_DEPS_DIR "${CMAKE_SOURCE_DIR}/${ZAP_DEPS_DIR}")
+endif()
+file(MAKE_DIRECTORY "${ZAP_DEPS_DIR}")
+
+set(ZAPEE_SOURCE "" CACHE PATH "Optional local source override for zapee")
+if(ZAPEE_SOURCE)
+    FetchContent_Declare(
+        zapee
+        SOURCE_DIR "${ZAPEE_SOURCE}"
+        BINARY_DIR "${CMAKE_BINARY_DIR}/_zapdeps/zapee"
+    )
+else()
+    FetchContent_Declare(
+        zapee
+        GIT_REPOSITORY "git@github.com:Zaptronics/zap-ee.git"
+        GIT_TAG        "v0.2.1"
+        GIT_SHALLOW    TRUE
+        GIT_PROGRESS   TRUE
+        SOURCE_DIR     "${ZAP_DEPS_DIR}/zapee"
+        BINARY_DIR     "${CMAKE_BINARY_DIR}/_zapdeps/zapee"
+    )
+endif()
+FetchContent_MakeAvailable(zapee)
+
+function(zap_apply_dependencies target_name)
+    if(NOT TARGET "${target_name}")
+        message(FATAL_ERROR "zap_apply_dependencies: target '${target_name}' does not exist")
+    endif()
+    target_link_libraries("${target_name}" PRIVATE
+        zap::ztm_pwm
+    )
+endfunction()
